#!/usr/bin/env bash
# Betterlockscreen standalone engine for Linux / i3 / CRD
# Blurs desktop/wallpaper, renders minimalist lock ring/icon and text, and invokes i3lock

set -euo pipefail

IMAGE_CACHE="$HOME/.cache/betterlockscreen/lockscreen.png"
WALLPAPER="$HOME/.local/share/wallpapers/default_wallpaper.jpg"
mkdir -p "$HOME/.cache/betterlockscreen"

generate_cache() {
    local src="$1"
    local tmp
    tmp="$(mktemp --suffix=.png)"

    # Resolve active resolution or fallback to 1920x1080
    local res
    res="$(xdpyinfo -display "${DISPLAY:-:20}" 2>/dev/null | awk '/dimensions:/ {print $2}' || true)"
    [ -z "$res" ] && res="1920x1080"

    # Resize/crop to current resolution, Gaussian blur and subtle dimming for Nord aesthetic
    convert "$src" \
        -resize "${res}^" -gravity center -extent "$res" \
        -filter Gaussian -resize 25% -define filter:sigma=1.5 -resize 400% \
        -fill "#2e3440" -colorize 25% \
        "$tmp"

    mv "$tmp" "$IMAGE_CACHE"
}

update_cache() {
    if [ -f "$WALLPAPER" ]; then
        generate_cache "$WALLPAPER"
        echo "betterlockscreen: Cache generated from $WALLPAPER"
    elif [ -n "${DISPLAY:-}" ] && command -v import >/dev/null 2>&1; then
        local tmp_shot
        tmp_shot="$(mktemp --suffix=.png)"
        import -window root "$tmp_shot"
        generate_cache "$tmp_shot"
        rm -f "$tmp_shot"
        echo "betterlockscreen: Cache generated from active display"
    fi
}

lock_screen() {
    # If cache does not exist, generate it now
    if [ ! -f "$IMAGE_CACHE" ]; then
        update_cache
    fi

    local locker="$HOME/.local/bin/i3lock-color"
    [ ! -x "$locker" ] && locker="i3lock"

    if [ -x "$locker" ] && [ "$locker" = "$HOME/.local/bin/i3lock-color" ]; then
        exec "$locker" \
            -n \
            ${IMAGE_CACHE:+-i "$IMAGE_CACHE"} \
            --clock \
            --indicator \
            --radius=42 \
            --ring-width=5 \
            --time-str="%H:%M" \
            --time-font="Iosevka Nerd Font" \
            --time-size=64 \
            --time-color="eceff4ff" \
            --date-str="%A, %B %d" \
            --date-font="Iosevka Nerd Font" \
            --date-size=16 \
            --date-color="d8dee9ff" \
            --time-pos="ix:iy-90" \
            --date-pos="ix:iy-58" \
            --ring-color="3b4252ff" \
            --ringver-color="ebcb8bff" \
            --ringwrong-color="bf616aff" \
            --inside-color="2e3440cc" \
            --insidever-color="ebcb8b33" \
            --insidewrong-color="bf616a33" \
            --keyhl-color="ebcb8bff" \
            --bshl-color="bf616aff" \
            --separator-color="00000000" \
            --verif-text="Verifying..." \
            --wrong-text="Incorrect Password" \
            --verif-color="eceff4ff" \
            --wrong-color="bf616aff" \
            --status-pos="ix:iy+68" \
            --verif-size=13 \
            --wrong-size=13
    elif [ -f "$IMAGE_CACHE" ]; then
        exec i3lock -n -i "$IMAGE_CACHE"
    else
        exec i3lock -n -c 2e3440
    fi
}

case "${1:-}" in
    -u|--update)
        if [ -n "${2:-}" ]; then
            generate_cache "$2"
        else
            update_cache
        fi
        ;;
    -l|--lock)
        lock_screen
        ;;
    *)
        lock_screen
        ;;
esac
